# Rust build artifacts.
# Cargo.lock is committed: this crate ships a binary, so the lockfile must be
# tracked for reproducible builds and `cargo install --git`.
target

# Editor / IDE build output (source lives in editors/vscode/src)
node_modules/
editors/vscode/out/
package-lock.json
editors/vscode/*.vsix

# OS
.DS_Store
Thumbs.db

# Environment & secrets
.env
.env.local
.env.*.local

# Logs
*.log

# Project scratch / lab-output directories
docs/
bench/
.playwright-cli/
info/
target-bench/
src/tui/snapshots/*.snap
sirbone-lab/

# The benchmark harnesses stay local: `bench/` is ignored wholesale by the rule
# above. The published record of what those campaigns decided lives in the
# decision layer below (docs/BENCH_DECISIONS.md, docs/STATUS.md).

# Version the compact benchmark contract and decision layer, not the wider
# scratch/docs tree.
docs/*
!docs/ACB_HARNESS.md
!docs/BENCH_DECISIONS.md
!docs/EVAL_HARNESS_PLAN.md
!docs/EVAL_RESUME.md
!docs/STATUS.md
!docs/TESTING.md
!docs/SEALED_EVALUATOR_RUNBOOK.md

# Python cache artifacts can appear inside otherwise-whitelisted fixture trees.
__pycache__/
.pytest_cache/
*.py[cod]


# Root-level hidden files and scratch notes.
# Anchored to root (leading /) so nested markdown — docs-site/book, playground,
# vendored READMEs — stays tracked; only top-level hidden files and .md notes
# are ignored.
/.*
/*.md
bench/*
# Exceptions — keep these tracked
!/.gitignore
!.github/
!.vscode/
!.cargo/
!.env.example
!README.md
!MISSION.md
!CONTRIBUTING.md
!SECURITY.md
!LICENSE*
!NOTICE
!playground/repl_tasks.sh
