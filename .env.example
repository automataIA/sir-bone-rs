# Uncomment ONE provider below and paste your key. Leave the others commented.
#
# ── Provider: Anthropic-like API ───────────────────────────────
# Set this to use the Anthropic path (also works with z.ai/GLM proxies).
# ANTHROPIC_AUTH_TOKEN=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com   # optional, default

# ── Provider: OpenAI-like API (also Ollama, Groq, etc.) ────────
# Used when ANTHROPIC_AUTH_TOKEN is not set.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1      # optional, default

# ── Provider: ChatGPT Plus/Pro via official Codex CLI ──────────
# This is OAuth through the local `codex` CLI, not an OpenAI API key.
# Run `sirbone login --codex`, then start with `SIRBONE_CODEX=1 sirbone`.
# SIRBONE_CODEX=1
# SIRBONE_MODEL=auto                              # let Codex choose the account's default model
# SIRBONE_CODEX_SANDBOX=workspace-write           # use danger-full-access only inside another trusted sandbox

# ── Agent settings ─────────────────────────────────────────────
# Full reference with current values: `sirbone env`
# SIRBONE_MODEL=claude-opus-4-7                   # model name
# SIRBONE_THINKING_BUDGET=10000                   # extended-thinking tokens (Anthropic path; also live-toggled in TUI Settings)
# SIRBONE_TEMPERATURE=0                            # sampling temperature (unset = provider default 1.0; pin for benches;
#                                                  # Claude models after Opus 4.6 reject anything but 1.0)
# SIRBONE_MAX_STEPS=40                             # safety cap on LLM turns per run (AFK bound; unset = no cap)
# SIRBONE_VISION=1                                 # the OpenAI-compatible endpoint reads images
#                                                  # (llama-server --mmproj, a vision model on OpenRouter)
# SIRBONE_THEME=dark                               # CLI/TUI color theme override (else cli.theme config)
# SIRBONE_NO_LOCALIZE=1                            # disable the localization pre-pass (one-shot + TUI)
# SIRBONE_NO_SNAPSHOT=1                             # disable the per-run workspace snapshot (shadow git; /rollback)
# SIRBONE_NO_COMPACT=1                             # disable context compaction (transcript grows unbounded)
# SIRBONE_NO_HISTORIA=1                            # disable HISTORIA per-project memory
# SIRBONE_NO_GROUND_CONTEXT=1                      # disable the proactive grounding context (structure pass)
# SIRBONE_WEB_FETCH_ALLOW_PRIVATE=1                # let web_fetch reach private/local addresses (dev servers)
# SIRBONE_CONTEXT_WINDOW=131072                    # context window override (tokens). Normally auto-detected
#                                                  # (Anthropic /v1/models, Groq/OpenRouter /models); set it for
#                                                  # providers that don't expose it (Ollama, bare proxies)

# ── Experimental / tuning flags ────────────────────────────────
# SIRBONE_NO_EDIT_HINT=1                            # opt-out: disable the nearest-match hint on a failed edit
#                                                  # (default ON — adds a re-quote suggestion on "not found")
# SIRBONE_GROUND=1                                 # opt-in: after a run, print deterministic verification of
#                                                  # the answer's claims about paths/symbols/counts
# SIRBONE_ORACLE=1                                 # opt-in: authoritative post-Done test gate in headless/REPL
# SIRBONE_ASK_ROUNDS=1                             # experimental 1-3 question ask_user schema
# SIRBONE_NO_GROUNDING=1                            # opt-out: drop the default verify-before-answer block
#                                                  # from the system prompt (default ON; set to A/B it)
# SIRBONE_NO_TOOLS=1                               # bench: register no tools at all (cold regime)
# SIRBONE_USAGE=1                                  # bench: print the per-feature usage line after a run
# SIRBONE_DISABLE=hook:post                        # bench: tool/prompt/hook/oracle/ask ablation spec
# SIRBONE_YAGNI=1                                  # bench: minimal-code prompt clause (A/B'd net-negative)
